[mysqld]
# Character set & collation
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# Performance Schema (required for data_locks / data_lock_waits observation)
performance_schema = ON

# Slow Query Log (accessible via both file and mysql.slow_log table)
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
log_output = FILE,TABLE
long_query_time = 0.5
log_queries_not_using_indexes = 0

# InnoDB diagnostics & lab-friendly lock wait timeout
innodb_print_all_deadlocks = ON
innodb_status_output_locks = ON
innodb_lock_wait_timeout = 15

# Binary Log (for Phase 5 & 6 crash recovery / mysqlbinlog experiments)
binlog_format = ROW
